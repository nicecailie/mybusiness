{
  "name": "mybusiness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mybusiness/api --filter @mybusiness/web dev",
    "dev:lan": "pnpm --parallel --filter @mybusiness/api --filter @mybusiness/web dev:lan",
    "build": "pnpm --filter @mybusiness/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @mybusiness/web typecheck && pnpm --filter @mybusiness/mobile typecheck",
    "test": "tsx --test tests/domain.test.ts tests/offline-queue.test.ts",
    "test:review": "tsx --test --test-concurrency=1 tests/review.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts tests/core-completion.test.ts tests/industry-workspace.test.ts tests/hospitality.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test",
    "test:http": "node scripts/test-http.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "licenses:inventory": "node scripts/licenses.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@hookform/resolvers": "6.0.0",
    "@nestjs/common": "12.3.1",
    "@nestjs/core": "12.3.1",
    "@nestjs/platform-express": "12.3.1",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.105.0",
    "better-auth": "1.7.14",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "pg": "8.23.1",
    "react-hook-form": "7.91.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "type": "module"
}
