# Separate migration owner and runtime role. These are local example values only.
MIGRATION_DATABASE_URL=postgresql://postgres:local-development-only@localhost:55439/mybusiness
DATABASE_URL=postgresql://mybusiness_app:local-development-only@localhost:55439/mybusiness
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
LAN_ORIGIN=
API_PORT=4000
API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
ALLOW_DEMO_SEED=false
ALLOW_REGISTRATION=true
# Configure a verified sender in Resend to deliver required account verification emails.
RESEND_API_KEY=
EMAIL_FROM=MyBusiness <subscription@atziltech.com>
# Optional HTTPS links for the terms accepted during business setup.
NEXT_PUBLIC_SUBSCRIPTION_AGREEMENT_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
SUBSCRIPTION_AGREEMENT_URL=
PRIVACY_POLICY_URL=
DEMO_OWNER_EMAIL=owner@example.test
DEMO_PASSWORD=replace-with-a-local-development-password
